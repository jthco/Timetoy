+                                if (onReady != null) mainHandler.post(onReady);
+                            } catch (Exception e) {
+                                TraceLog.e("TAPE3 session configure error", e);
+                                try { s.close(); } catch (Exception ignored) {}
+                                if (session == s) session = null;
+                                if (tape3 == newTape3) closeTape3();
+                                running = false;
+                                updateOverlay("Tape3 session start failed: " + e);
+                            }
+                        }
+
+                        @Override public void onConfigureFailed(CameraCaptureSession s) {
+                            TraceLog.i("TAPE3 session failed");
+                            try { s.close(); } catch (Exception ignored) {}
+                            if (session == s) session = null;
+                            if (tape3 == newTape3) closeTape3();
+                            running = false;
+                            updateOverlay("Tape3 1080p60 stream combination failed");
+                        }
+                    },
+                    cameraHandler
+            );
